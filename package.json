{
  "name": "hiv-logbook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:setup": "node --env-file=.env.local --import tsx scripts/db-setup.ts",
    "db:check": "drizzle-kit check",
    "auth:create-user": "node --env-file=.env.local --import tsx scripts/create-user.ts",
    "test": "npm run test:unit",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest watch --project unit",
    "test:unit:coverage": "vitest run --project unit --coverage",
    "test:integration": "node -e \"console.error('Integration tests are not implemented.'); process.exit(1)\"",
    "test:e2e": "node -e \"console.error('E2E tests are not implemented.'); process.exit(1)\""
  },
  "dependencies": {
